generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int       @id @default(autoincrement())
  username  String?
  email     String    @unique
  password  String
  expenses  Expense[]
  createdAt DateTime  @default(now())
}

model Expense {
  id        Int      @id @default(autoincrement())
  amount    Float
  category  String
  note      String?
  createdAt DateTime @default(now())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
}